  "exclusions": [
    {
      "kind": "runtime-state",
      "examples": [
        "memory databases",
        "task databases",
        "hook state",
        "baselines",
        "backups"
      ],
      "reason": "private mutable data"
    },
    {
      "kind": "generated",
      "examples": [
        "node_modules",
        "dist",
        "build logs",
        "reports"
      ],
      "reason": "rebuild during isolated installation"
    },
    {
      "kind": "third-party",
      "examples": [
        "system skills",
        "curated plugins",
        "vendor caches"
      ],
      "reason": "dependency only; keep upstream ownership"
    }
  ]
