{
  "mcpServers": {
    "codex-memory-pro": {
      "command": "node",
      "args": [
        "./dist/mcp-server.js"
      ],
      "cwd": ".",
      "env": {
        "MEMORY_DB_PATH": "~/.codex/memory-pro/lancedb",
        "EMBEDDING_BASE_URL": "https://api.siliconflow.cn/v1",
        "EMBEDDING_MODEL": "BAAI/bge-m3",
        "EMBEDDING_API_KEY": "${EMBEDDING_API_KEY}",
        "CAPTURE_API_KEY": "${CAPTURE_API_KEY}",
        "CAPTURE_BASE_URL": "https://open.bigmodel.cn/api/paas/v4",
        "CAPTURE_MODEL": "glm-4.5-flash"
      }
    }
  }
}
