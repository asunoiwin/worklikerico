{
  "name": "claude-memory-pro",
  "version": "2.0.2",
  "description": "语义记忆增强 v2 — LanceDB 向量数据库 + 知识图谱 + 记忆晋升 + 自动捕获 + 自适应检索",
  "author": {
    "name": "Rico"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start-hook.cjs\"",
            "statusMessage": "加载语义记忆 + 工作先验..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start-hook.cjs\"",
            "statusMessage": "上下文压缩后重新注入记忆先验..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end-hook.cjs\"",
            "statusMessage": "刷新习惯数据..."
          }
        ]
      }
    ]
  }
}
